# ============================================================
# 博主参数：陆游（母版 · genz.ltd）
# 说明：这是「标准博主模板」的基准实例。克隆时以本文件为对照，
#       clone-blogger.sh 会把母版中的 genz.ltd 域名替换为目标博主域名。
# ============================================================

BLOGGER_NAME="陆游"
BLOGGER_SLUG="luyou"
BLOGGER_TITLE="陆游 · 星际诗人"

MAIN_DOMAIN="genz.ltd"
WWW_DOMAIN="www.genz.ltd"
API_DOMAIN="api.genz.ltd"
APP_DOMAIN="app.genz.ltd"
TSPACE_DOMAIN="tspace.genz.ltd"

# 占位——陆游线上 JWT_SECRET 在 Vultr 的 backend/.env，不入库
JWT_SECRET="REPLACE_WITH_openssl_rand_hex_32"

REPO_URL="https://gitee.com/szbenyx/looma-zervi.git"
BRANCH="release/overseas"
DEPLOY_REGION="SG"

# 陆游=全集，不按作者切分
POETRY_AUTHOR=""
POETRY_SOURCE_DIR="data/poetry_full"
POETRY_TARGET_DIR=""
