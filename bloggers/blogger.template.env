# ============================================================
# 博主参数文件（单一事实来源）
# ------------------------------------------------------------
# 用法：
#   cp blogger.template.env bloggers/<slug>.env
#   填好下面字段 → bash scripts/clone-blogger.sh bloggers/<slug>.env
#
# 约定：
#   - 本文件用 bash 语法（KEY="value"），clone-blogger.sh 会 source 它
#   - 值里不要出现中文引号 / 反斜杠 / 换行
#   - 必填字段：BLOGGER_NAME / BLOGGER_SLUG / MAIN_DOMAIN / JWT_SECRET
#   - 其余域名若不填，脚本按 MAIN_DOMAIN 自动推导
# ============================================================

# --- 博主身份（必填） ---
BLOGGER_NAME="李白"                 # 中文名，写进克隆 README
BLOGGER_SLUG="libai"                # 英文短名（小写字母/数字/连字符），用作目录名
BLOGGER_TITLE="李白 · 诗仙"          # 站点标题，写进克隆 README

# --- 域名（MAIN_DOMAIN 必填，其余可选） ---
MAIN_DOMAIN="libai.example.com"     # 主域（营销/官网）
WWW_DOMAIN=""                        # 留空 → www.${MAIN_DOMAIN}
API_DOMAIN=""                        # 留空 → api.${MAIN_DOMAIN}
APP_DOMAIN=""                        # 留空 → app.${MAIN_DOMAIN}（PlanetX 前端，Vercel）
TSPACE_DOMAIN=""                     # 留空 → tspace.${MAIN_DOMAIN}（T空间 SaaS）

# --- 安全（必填） ---
# 生成随机串：openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_openssl_rand_hex_32"

# --- 部署（一般沿用，可按需改） ---
REPO_URL="https://gitee.com/szbenyx/looma-zervi.git"
BRANCH="release/overseas"
DEPLOY_REGION="SG"

# --- 诗词「货」切分（可选，由 poetry-split-by-author.py 使用） ---
# 从陆游母版 data/poetry_full 按作者名切出的子库；留空则沿用全集
POETRY_AUTHOR="李白"                # 例：李白 / 白居易；留空=不切分，用全集
POETRY_SOURCE_DIR="data/poetry_full"          # 源 ChromaDB 目录（陆游全集）
POETRY_TARGET_DIR="data/poetry_full_libai"    # 切分后目录，部署时替换母版同名目录
