# ========================================
# Optional: Backend + PlanetX SPA all-in-one image
# Build from repo root:
#   docker build -f docker/Dockerfile.planetx-app -t looma-planetx-app .
# Overseas / CI keep using Dockerfile.backend (backend-only; frontend is rsync-excluded).
# ========================================

# Stage 1: Build PlanetX Frontend
FROM node:20-alpine AS frontend-builder

WORKDIR /src/frontend

COPY frontend/pnpm-workspace.yaml frontend/package.json frontend/pnpm-lock.yaml ./
COPY frontend/packages/shared-core ./packages/shared-core
COPY frontend/packages/planetx ./packages/planetx

RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install --frozen-lockfile
RUN VITE_API_BASE="" pnpm --filter @looma/shared-core build
RUN VITE_API_BASE="" pnpm --filter @looma/planetx build

# Stage 2: Python Backend + PlanetX SPA
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    FLASK_ENV=production \
    FLASK_PORT=5200 \
    PLANETX_DIST_DIR=/app/planetx-dist

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' \
    /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt -i https://mirrors.aliyun.com/pypi/simple/

COPY backend/ .
COPY --from=frontend-builder /src/frontend/packages/planetx/dist /app/planetx-dist

EXPOSE 5200

CMD ["gunicorn", "--config", "gunicorn_config.py", "src.app:create_app()"]
