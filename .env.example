# ──────────────────────────────────────────
#  Looma & Zervi — 环境变量配置（跨平台模板）
#  复制此文件为 .env 并修改对应值
#  Windows 用户：注意路径分隔符用 / 或 \\
# ──────────────────────────────────────────

# ── 数据库（pgvector）────────────────────
# Docker 默认映射：宿主机 5433 → 容器 5432
#   若直接安装 PostgreSQL，通常用 5432
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DATABASE=looma

# ── Ollama（本地 LLM + Embedding）────────
# Mac/Windows 均默认 http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text:latest
LLM_MODEL=ollama/qwen2.5-coder:1.5b

# ── LLM Provider 优先级（逗号分隔，按优先级尝试）──
# 当主 LLM_MODEL 不可用时，自动按此顺序切换 provider
# 支持值："ollama", "deepseek", "openai"
LLM_PROVIDER_ORDER=ollama,deepseek,openai

# 可选：为每个 LLM provider 指定 model 名称（若未设置则使用 LLM_MODEL）
OLLAMA_MODEL=
DEEPSEEK_MODEL=
OPENAI_MODEL=

# ── Embedding Provider 优先级（独立于 LLM provider）──
# 支持值："ollama", "openai", "deepseek"
EMBED_PROVIDER_ORDER=ollama,openai,deepseek

# 可选：为每个 embedding provider 指定 model 名称
#   ollama 使用 EMBED_MODEL
#   openai 默认 text-embedding-3-small
#   deepseek 默认 deepseek-chat
OPENAI_EMBED_MODEL=
DEEPSEEK_EMBED_MODEL=

# ── API Keys（按需配置，不配则跳过对应 provider）──
OPENAI_API_KEY=
OPENAI_BASE_URL=                # 可选：自定义 API 代理地址

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=              # 可选：默认 https://api.deepseek.com/v1

# ── 调用弹性策略（超时/重试/熔断）──────
LLM_CALL_TIMEOUT=120
LLM_MAX_RETRIES=2
EMBED_CALL_TIMEOUT=30
API_REQUEST_TIMEOUT=90
EMBED_MAX_RETRIES=2

# ── LlamaIndex ──────────────────────────
EMBED_DIM=768

# ── 服务配置 ─────────────────────────────
LOOMA_HOST=127.0.0.1
LOOMA_PORT=8010

# ── 认证 ─────────────────────────────────
# AUTH_STUB=true  → 开发模式，任意 Bearer token 均可访问（视为 free 用户）
# AUTH_STUB=false → 生产模式，需用真实 Supabase JWT
AUTH_STUB=true

# Supabase 配置（AUTH_STUB=false 时使用）
# 获取路径：Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your_jwt_secret_here

# ── 对象存储（可选）───────────────────
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=looma-uploads

# ── 诗词库 Chroma 路径（可选）────────────
# Mac 示例：POETRY_CHROMA_PATH=./data/poetry_full
# Windows 示例：POETRY_CHROMA_PATH=D:/looma-zervi/data/poetry_full
# 留空则使用 pgvector 作为向量存储
# POETRY_CHROMA_PATH=
