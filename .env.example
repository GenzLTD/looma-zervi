# ============================================
# Looma Backend Environment Configuration
# ============================================
# Copy to .env and fill in real values

# --- Flask ---
FLASK_ENV=development
FLASK_PORT=5200
SECRET_KEY=change-me-to-a-random-string

# --- JWT Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-secure-random-key
JWT_EXPIRY_HOURS=24
JWT_ALGORITHM=HS256

# --- WeChat MiniApp (dev: set WECHAT_DEV_MODE=true in backend/.env) ---
# From WeChat MP console (mp.weixin.qq.com)
WECHAT_APPID=your-appid
WECHAT_APP_SECRET=your-app-secret
WECHAT_DEV_MODE=true

# --- Payment (see docs/COMMERCE_CLOSURE_STATUS.md) ---
PAYMENT_STUB_MODE=true
# WECHAT_MCHID=
# WECHAT_API_V3_KEY=
# WECHAT_SERIAL_NO=
# WECHAT_PRIVATE_KEY_PATH=/secure/apiclient_key.pem
# WECHAT_NOTIFY_URL=https://api.szbolent.com.cn/v1/payment/wechat/notify
# SALES_WEBHOOK_URL=

# --- DeepSeek API ---
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- QCC (企查查) MCP — enterprise credit ---
# Docker 实际加载的是 backend/.env（见 docker/docker-compose.yml env_file）。
# 配好后需: cd docker && docker compose up -d --force-recreate backend
# Token 可带或不带 "Bearer " 前缀。
QCC_ENABLED=true
QCC_AUTH_TOKEN=
# Overseas SG → China QCC gateway (default: official https://agent.qcc.com/mcp)
# QCC_MCP_BASE_URL=http://1.14.202.161:8998/mcp


# --- ChromaDB ---
CHROMA_MODE=local          # local | remote
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=looma_knowledge

# --- SQLite ---
DATABASE_PATH=data/looma.db

# --- Poetry RAG (58k 诗词向量库，仓库根目录 data/poetry_full) ---
POETRY_CHROMA_PATH=data/poetry_full

# --- CORS ---
# 开发：planetx :5173 · saas :5174 · portal :3000
# 生产：须含 https://szbolent.cn,https://www.szbolent.cn（portal 联调 · DECISION_RESPONSE W1）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://szbolent.cn,https://www.szbolent.cn

# --- Quota ---
FREE_DAILY_LIMIT=30
SUPPORTER_DAILY_LIMIT=999999
PRO_DAILY_LIMIT=999999

# --- LLM Provider (comma-separated, tried in order) ---
# Provider order controls fallback chain: when provider N fails, try N+1.
# Recommended order for Looma production:
#   LLM_PROVIDER_ORDER=deepseek,ollama,openai
#   → DeepSeek first (fast + cheap), Ollama local fallback, OpenAI last.
# For overseas (Ollama-only / offline):
#   LLM_PROVIDER_ORDER=ollama,deepseek
#   → Ollama first (qwen2.5-coder:1.5b), remote fallback if needed.
# For DemoPeter thin-ingest mode: upload→persist ALWAYS succeeds
#   (persist is decoupled from LLM extraction since L-P0-1).
# Set to empty string to disable all LLM providers.
LLM_PROVIDER_ORDER=deepseek,ollama,openai
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Embedding ---
EMBED_PROVIDER_ORDER=ollama,deepseek
EMBED_MODEL=nomic-embed-text:latest
EMBED_DIM=768

# --- API ---
API_REQUEST_TIMEOUT=90.0

# --- pgvector (optional — for RAG fallback) ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=looma

# --- Navigator Psychology ---
PSYCHOLOGY_ENABLED=true
PSYCHOLOGY_API_TYPE=local
SENTINO_API_KEY=

# --- CloudBase (miniprogram shell) ---
# Only needed for CloudBase cloud functions
CLOUDBASE_ENV_ID=your-cloudbase-env-id

# --- GFCC chain B (empty = skip). Same keys as backend/.env.example ---
GFCC_SIGNAL_INGEST_URL=
SIGNAL_INGEST_SECRET=
