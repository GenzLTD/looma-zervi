{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GFCC consensus_match signal payload v1",
  "version": "1.0.0",
  "description": "DemoPPI match fact. Routed to consensus port as score evidence. User-action origin only.",
  "source": "demoppi",
  "route": "consensus",
  "type": "object",
  "required": ["match_score", "shared_tags", "peer_id_hash", "source"],
  "additionalProperties": false,
  "properties": {
    "match_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Jaccard similarity in [0, 1]"
    },
    "shared_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1 }
    },
    "peer_id_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Counterparty user_id_hash. Formerly peer_email_hash in THOMAS draft."
    },
    "source": {
      "type": "string",
      "const": "demoppi"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
