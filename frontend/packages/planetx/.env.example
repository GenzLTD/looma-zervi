# PlanetX Web — 本地 / 海外

# API（开发可用空，走 vite proxy /v1 → :5200）
# VITE_API_BASE_URL=https://api.genz.ltd

# 海外 Google 登录（GIS）。不配置则 Auth 页只显示邮箱登录。
# VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# 强制在非 PROD 环境也注册 Service Worker（PWA 联调）
# VITE_ENABLE_PWA=true

# --- Supabase 统一认证（THOMAS 生态，RFC docs/rfc/supabase-unified-auth-v1.md）---
# 配置后登录/注册走 Supabase（后端 require_auth 双 token 兼容）；不配置走旧 looma 路径
# VITE_SUPABASE_URL=https://ftsnrqwynofsxdvoxnsw.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
