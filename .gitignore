# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv
*.egg-info/
dist/
build/

# Environment
.env
.env.local
.env.production
*.pem
*.key

# Node
node_modules/
frontend/packages/*/dist/
frontend/packages/*/.vite/
