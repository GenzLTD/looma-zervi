.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Database
*.db
*.db-wal
*.db-shm
backend/data/

# ChromaDB
backend/chroma_data/

# Logs
logs/
*.log

# Docker
docker/data/

# Miniprogram
frontend/packages/miniprogram/miniprogram_npm/
# TS build artifacts - DO NOT put *.js in miniprogram/.gitignore (DevTools reads it as packaging rule)
frontend/packages/miniprogram/**/*.js
!frontend/packages/miniprogram/typings/*.d.ts

# Data files (large binaries)
data/

# Smoke test state
*.smoke_state*.json

# Root package-lock (frontend uses pnpm)
package-lock.json

# Reports archive
reports.zip

# cutover-test runtime artifacts (rendered nginx.conf / mime.types / logs)
scripts/cutover-test/.generated/

# Legacy web UI
web/

# Playwright
frontend/playwright-report/
frontend/test-results/
test-results/
.cursor/
.playwright-cli/

# Local agent memory (do not commit)
frontend/.workbuddy/
.workbuddy/

# Deployment SSH keys
.ssh/

# Internal test credentials (copy from 内测志愿者账号与入口.example.md)
docs/内测志愿者账号与入口.md
.pnpm-store/

# Supabase CLI local cache (project link state)
supabase/.temp/

# Deploy-time commit marker (written by deploy scripts, read by /health)
backend/git_commit.txt

# Blogger clone artifacts (generated by scripts/clone-blogger.sh)
clones/
# Blogger param files may contain real secrets (JWT_SECRET); keep only templates/examples
bloggers/*.env
!bloggers/blogger.template.env
!bloggers/luyou.env

# ============================================================
# 商业 / 法务 / 客户文档 —— 一律不入库   [sensitive-doc-guard v1]
# 本机另有全局规则 ~/.config/git/ignore 兜底；这里再写一份，
# 保证规则随仓库同步到其他机器与协作者。
# 命中示例：香江商学院-深圳外服集团战略合作框架协议(征求意见稿）.docx
# ⚠️ gitignore 是「最后一条匹配的规则胜出」：请勿在本块之后追加
#    !*.txt / !*.csv 之类反选，否则会覆盖下面的显式文件名规则。
# ============================================================

# 清单 / 台账类（含 D:\ 全盘路径、客户名录）
kb_inventory.txt
kb_inventory*.txt
*文件清单*.txt
*目录清单*.txt
*盘清单*.txt

# 合同 / 协议 / 法务文本
*战略合作*
*框架协议*
*合作协议*
*协议*
*合同*
*征求意见稿*
*意向书*
*承诺书*
*授权书*
*委托书*
*保密*
*章程*
*股东决议*
*决议*
*股权*
*尽职调查*
*尽调*
*审计*
*报价*
*标书*
*对账*
*发票*
*营业执照*
*商业计划书*

# 反选：避免中文关键词误伤代码 / 配置文件（.txt/.csv 故意不含在内）
!*.py
!*.js
!*.jsx
!*.ts
!*.tsx
!*.vue
!*.go
!*.rs
!*.java
!*.kt
!*.sql
!*.sh
!*.bash
!*.zsh
!*.md
!*.mdx
!*.json
!*.jsonc
!*.yaml
!*.yml
!*.toml
!*.ini
!*.cfg
!*.html
!*.css
!*.scss
!*.lock
